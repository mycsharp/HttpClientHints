@using Microsoft.AspNetCore.Http.Features
@using MyCSharp.HttpClientHints
@using MyCSharp.HttpClientHints.AspNetCore
@{
    ViewData["Title"] = "Home Page";

    // Registered by app.UseHttpClientHintsFeature() in Program.cs.
    // Context.GetClientHints() returns the same snapshot without the feature.
    HttpClientHints clientHints = Context.Features.GetRequiredFeature<IHttpClientHintsFeature>().Snapshot;
    IReadOnlyList<HttpClientHintsBrand> brands = clientHints.DecodedFullVersionList ?? clientHints.DecodedUA ?? [];
}

<div class="text-center">
    <h1 class="display-4">HTTP Client Hints</h1>
    <p>Browsers send most of these headers only after a response has requested them with <code>Accept-CH</code>. Reload the page if values are missing.</p>
    <div>
        <table class="table">
            <thead class="thead-dark">
                <tr>
                    <th scope="col">Header</th>
                    <th scope="col">Value as sent</th>
                    <th scope="col">Decoded value</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>User-Agent</td>
                    <td>@(clientHints.UserAgent)</td>
                    <td></td>
                </tr>
                <tr>
                    <td>Sec-CH-UA</td>
                    <td>@(clientHints.UA)</td>
                    <td>@(string.Join(", ", clientHints.DecodedUA?.Select(static brand => $"{brand.Brand} {brand.Version}") ?? []))</td>
                </tr>
                <tr>
                    <td>Sec-CH-UA-Full-Version-List</td>
                    <td>@(clientHints.FullVersionList)</td>
                    <td>@(string.Join(", ", clientHints.DecodedFullVersionList?.Select(static brand => $"{brand.Brand} {brand.Version}") ?? []))</td>
                </tr>
                <tr>
                    <td>Sec-CH-UA-Platform</td>
                    <td>@(clientHints.Platform)</td>
                    <td>@(clientHints.DecodedPlatform)</td>
                </tr>
                <tr>
                    <td>Sec-CH-UA-Platform-Version</td>
                    <td>@(clientHints.PlatformVersion)</td>
                    <td>@(clientHints.DecodedPlatformVersion)</td>
                </tr>
                <tr>
                    <td>Sec-CH-UA-Arch</td>
                    <td>@(clientHints.Architecture)</td>
                    <td>@(clientHints.DecodedArchitecture)</td>
                </tr>
                <tr>
                    <td>Sec-CH-UA-Bitness</td>
                    <td>@(clientHints.Bitness)</td>
                    <td>@(clientHints.DecodedBitness)</td>
                </tr>
                <tr>
                    <td>Sec-CH-UA-WoW64</td>
                    <td></td>
                    <td>@(clientHints.Wow64)</td>
                </tr>
                <tr>
                    <td>Sec-CH-UA-Model</td>
                    <td>@(clientHints.Model)</td>
                    <td>@(clientHints.DecodedModel)</td>
                </tr>
                <tr>
                    <td>Sec-CH-UA-Form-Factors</td>
                    <td>@(clientHints.FormFactors)</td>
                    <td>@(string.Join(", ", clientHints.DecodedFormFactors ?? []))</td>
                </tr>
                <tr>
                    <td>Sec-CH-UA-Mobile</td>
                    <td></td>
                    <td>@(clientHints.Mobile)</td>
                </tr>
            </tbody>
        </table>
    </div>
    <h2>Brands</h2>
    <table class="table">
        <thead class="thead-dark">
            <tr>
                <th scope="col">Brand</th>
                <th scope="col">Version</th>
                <th scope="col">GREASE</th>
            </tr>
        </thead>
        <tbody>
            @foreach (HttpClientHintsBrand brand in brands)
            {
                <tr>
                    <td>@(brand.Brand)</td>
                    <td>@(brand.Version)</td>
                    <td>@(brand.IsGrease)</td>
                </tr>
            }
        </tbody>
    </table>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
