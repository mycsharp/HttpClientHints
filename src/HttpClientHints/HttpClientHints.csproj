<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Product>HTTP Client Hints</Product>
    <Description>Reads HTTP Client Hints such as Sec-CH-UA, Sec-CH-UA-Platform and Sec-CH-UA-Mobile and decodes their structured values.</Description>
  </PropertyGroup>

  <PropertyGroup Label="Native AOT and trimming">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup Label="Dependencies" Condition="'$(TargetFramework)' != 'net11.0'">
    <PackageReference Include="Microsoft.Extensions.Primitives" />
  </ItemGroup>
</Project>
